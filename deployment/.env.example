MODEL_BASE_URL=https://your-provider.example/v1
MODEL_NAME=your-model-name
FILE_SURFER_API_KEY=
FILE_SURFER_BASE_URL=
FILE_SURFER_MODEL=your-tool-calling-model
WEB_SURFER_API_KEY=
WEB_SURFER_BASE_URL=
